import numpy as np
from scipy import stats

data = np.array([10, 12, 15, 18, 20, 20, 22, 25, 28, 30])

print("----- STATISTICAL MEASURES -----")

print("Mean:", stats.tmean(data))
print("Median:", np.median(data))
print("Mode:", stats.mode(data, keepdims=True).mode[0])
print("Variance:", np.var(data, ddof=1))
print("Standard Deviation:", np.std(data, ddof=1))
print("Skewness:", stats.skew(data))
print("Kurtosis:", stats.kurtosis(data))
print("Minimum:", np.min(data))
print("Maximum:", np.max(data))
print("Range:", np.max(data) - np.min(data))

print("\n----- DESCRIPTIVE STATISTICS -----")

result = stats.describe(data)

print("Number of observations:", result.nobs)
print("Minimum:", result.minmax[0])
print("Maximum:", result.minmax[1])
print("Mean:", result.mean)
print("Variance:", result.variance)
print("Skewness:", result.skewness)
print("Kurtosis:", result.kurtosis)

print("\n----- ONE SAMPLE T-TEST -----")

t_stat, p_value = stats.ttest_1samp(data, 20)

print("T-statistic:", t_stat)
print("P-value:", p_value)

if p_value < 0.05:
    print("Reject Null Hypothesis")
else:
    print("Accept Null Hypothesis")

print("\n----- INDEPENDENT T-TEST -----")

group1 = np.array([70, 75, 80, 85, 90])
group2 = np.array([65, 70, 72, 78, 82])

t_stat, p_value = stats.ttest_ind(group1, group2)

print("T-statistic:", t_stat)
print("P-value:", p_value)

if p_value < 0.05:
    print("The groups are significantly different")
else:
    print("The groups are not significantly different")

print("\n----- PEARSON CORRELATION TEST -----")

hours = np.array([2, 3, 4, 5, 6, 7])
marks = np.array([50, 55, 60, 68, 75, 80])

correlation, p_value = stats.pearsonr(hours, marks)

print("Correlation:", correlation)
print("P-value:", p_value)

if p_value < 0.05:
    print("There is a significant correlation")
else:
    print("There is no significant correlation")
