from bs4 import BeautifulSoup

html = """
<html>
<head>
    <title>Student Information</title>
</head>
<body>
    <h1>Student Details</h1>
    
    <div class="student">
        <h2>Pranav</h2>
        <p>Course: BE</p>
        <p>Semester: 5</p>
    </div>
    
    <div class="student">
        <h2>Rahul</h2>
        <p>Course: BE</p>
        <p>Semester: 5</p>
    </div>
    
    <ul>
        <li>Python</li>
        <li>Web Development</li>
        <li>Computer Networks</li>
    </ul>
    
    <a href="https://example.com">Example Website</a>
</body>
</html>
"""

soup = BeautifulSoup(html, "html.parser")

print("----- TITLE -----")
print(soup.title.text)

print("\n----- HEADING -----")
print(soup.h1.text)

print("\n----- STUDENT NAMES -----")
for student in soup.find_all("h2"):
    print(student.text)

print("\n----- PARAGRAPHS -----")
for p in soup.find_all("p"):
    print(p.text)

print("\n----- SUBJECTS -----")
for li in soup.find_all("li"):
    print(li.text)

print("\n----- LINKS -----")
for link in soup.find_all("a"):
    print("Text:", link.text)
    print("URL:", link.get("href"))

print("\n----- STUDENT DIVS -----")
students = soup.find_all("div", class_="student")

for student in students:
    print(student.get_text(" ", strip=True))

print("\n----- FIRST STUDENT -----")
first_student = soup.find("div", class_="student")
print(first_student.get_text(" ", strip=True))
