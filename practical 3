num = 10

if num > 0:
    print("Positive number")

age = 20

if age >= 18:
    print("Eligible to vote")
else:
    print("Not eligible to vote")

marks = 82

if marks >= 90:
    print("Grade A+")
elif marks >= 75:
    print("Grade A")
elif marks >= 60:
    print("Grade B")
else:
    print("Grade C")

i = 1
while i <= 5:
    print("While:", i)
    i += 1

for i in range(1, 6):
    print("For:", i)

for i in range(1, 4):
    for j in range(1, 4):
        print(i, j)

for i in range(1, 11):
    if i == 6:
        break
    print("Break:", i)

for i in range(1, 11):
    if i == 5:
        continue
    print("Continue:", i)

for i in range(1, 6):
    if i == 3:
        pass
    print("Pass:", i)
